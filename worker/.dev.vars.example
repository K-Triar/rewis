# ローカル開発（wrangler dev）用の環境変数の記入例です。
# このファイルをコピーして .dev.vars を作り、値を置き換えてください。
# 本物のユーザーID・パスワードハッシュ・ソルトはこのファイルに書かないでください（Git 管理対象です）。
# ハッシュは node generate-hash.js "<password>" "<salt>" で作成できます。
AUTH_USERS_JSON='[
  {"userId":"example-user","passwordHash":"replace-with-sha256-hex-of-password-plus-salt"}
]'
PASSWORD_SALT='replace-with-random-long-string'
ALLOWED_ORIGIN='https://k-triar.github.io'
TOKEN_TTL_SECONDS='1800'
